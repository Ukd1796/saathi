# Copy to .env. Never commit .env.
BOLNA_API_KEY=
# Where Bolna reaches this backend: your cloudflared tunnel URL now, the deployed URL later.
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# Long random string; signs login cookies. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   (defaults to SQLite saathi.db)
# COOKIE_SECURE=1   (set when served over https)
